generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  STAFF
  VIEWER
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  OUT_OF_STOCK
  SOLD
  ARCHIVED
  DELETED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum BlogStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum OfferStatus {
  ACTIVE
  EXPIRED
  DISABLED
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  LOW_STOCK
  OFFER_EXPIRY
  NEW_BOOKING
  NEW_CONTACT
  SYSTEM_ALERT
}

enum OrderStatus {
  NEW
  CONFIRMED
  PROCESSING
  READY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  RECEIVED
  VERIFIED
  FAILED
  REFUNDED
}

enum ReturnStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PICKUP_SCHEDULED
  REFUNDED
}

enum OpticalAddOnType {
  COATING
  TINT
  MATERIAL
  FILTER
  TREATMENT
  ACCESSORY
}

enum ConsultationStatus {
  PENDING_REVIEW
  PRESCRIPTION_REVIEWED
  CUSTOMER_CONTACTED
  WAITING_FOR_APPROVAL
  CONFIRMED
  AWAITING_FINAL_PAYMENT
  LENS_IN_PRODUCTION
  QUALITY_CHECK
  READY_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

// ------------------------------------------------------------------
// SAAS / FOUNDATION
// ------------------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid())
  name      String
  domain    String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultations Consultation[]

  @@map("tenants")
}

model MediaAsset {
  id         String   @id @default(uuid())
  url        String
  type       String // image, pdf, video, etc
  mime       String?
  size       Int?
  uploadedBy String?
  entityType String? // e.g., 'Product', 'Prescription'
  entityId   String?
  createdAt  DateTime @default(now())

  prescriptions Prescription[]

  @@map("media_assets")
}

model SystemEvent {
  id        String   @id @default(uuid())
  entity    String
  entityId  String
  action    String
  userId    String?
  oldValue  Json?
  newValue  Json?
  timestamp DateTime @default(now())

  @@index([entity, entityId])
  @@map("system_events")
}

// ------------------------------------------------------------------
// AUTH / USERS / RBAC
// ------------------------------------------------------------------

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String
  firstName        String
  lastName         String
  phone            String?
  role             Role      @default(STAFF)
  isActive         Boolean   @default(true)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  lastLoginIp      String?
  avatarUrl        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  permissions       UserPermission[]
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  assignedBookings  EyeTestBooking[]     @relation("AssignedStaffBookings")
  assignedEnquiries ContactEnquiry[]     @relation("AssignedStaffEnquiries")
  passwordResets    PasswordResetToken[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model UserPermission {
  id       String  @id @default(uuid())
  userId   String
  resource String
  action   String
  allowed  Boolean @default(true)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource, action])
  @@map("user_permissions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ------------------------------------------------------------------
// OPTICAL PRODUCT ENGINE / CATALOGUE
// ------------------------------------------------------------------

model CatalogueVersion {
  id          String   @id @default(uuid())
  version     String   @unique
  publishedAt DateTime @default(now())
  publishedBy String?

  orders        Order[]
  consultations Consultation[]

  @@map("catalogue_versions")
}

model RecommendationCategory {
  id        String   @id @default(uuid())
  name      String
  iconUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("recommendation_categories")
}

model OpticalLensType {
  id          String    @id @default(uuid())
  name        String
  description String?
  basePrice   Decimal   @db.Decimal(10, 2)
  salePrice   Decimal?  @db.Decimal(10, 2)
  taxRate     Decimal   @default(0) @db.Decimal(10, 2)
  isActive    Boolean   @default(true)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  compatibleAddOns   LensAddOnCompatibility[]
  compatibleVariants VariantLensCompatibility[]

  @@map("optical_lens_types")
}

model OpticalAddOn {
  id                   String           @id @default(uuid())
  name                 String
  type                 OpticalAddOnType
  description          String?
  basePrice            Decimal          @db.Decimal(10, 2)
  salePrice            Decimal?         @db.Decimal(10, 2)
  taxRate              Decimal          @default(0) @db.Decimal(10, 2)
  requiresPrescription Boolean          @default(false)
  isActive             Boolean          @default(true)
  archivedAt           DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  compatibleLenses LensAddOnCompatibility[]

  @@map("optical_add_ons")
}

model LensAddOnCompatibility {
  lensTypeId String
  addOnId    String

  lens  OpticalLensType @relation(fields: [lensTypeId], references: [id], onDelete: Cascade)
  addOn OpticalAddOn    @relation(fields: [addOnId], references: [id], onDelete: Cascade)

  @@id([lensTypeId, addOnId])
  @@map("lens_add_on_compatibility")
}

model VariantLensCompatibility {
  variantId  String
  lensTypeId String

  variant ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  lens    OpticalLensType @relation(fields: [lensTypeId], references: [id], onDelete: Cascade)

  @@id([variantId, lensTypeId])
  @@map("variant_lens_compatibility")
}

// ------------------------------------------------------------------
// CATALOGUE / COMMERCE
// ------------------------------------------------------------------

model Brand {
  id           String    @id @default(uuid())
  name         String    @unique
  slug         String    @unique
  logoUrl      String?
  country      String?
  description  String?
  website      String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  purgeAt      DateTime?

  products Product[]

  @@index([slug])
  @@map("brands")
}

model Category {
  id             String    @id @default(uuid())
  name           String
  slug           String    @unique
  description    String?
  iconUrl        String?
  imageUrl       String?
  parentId       String?
  displayOrder   Int       @default(0)
  isActive       Boolean   @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([slug])
  @@index([parentId])
  @@map("categories")
}

model Product {
  id                String        @id @default(uuid())
  name              String
  slug              String        @unique
  description       String?
  price             Decimal       @db.Decimal(10, 2)
  originalPrice     Decimal?      @db.Decimal(10, 2)
  status            ProductStatus @default(DRAFT)
  stock             Int           @default(0)
  lowStockThreshold Int           @default(3)

  gender       String?
  material     String?
  frameShape   String?
  frameWidth   Int?
  lensWidth    Int?
  bridgeWidth  Int?
  templeLength Int?
  weight       Int?
  warranty     String?

  seoTitle       String?
  seoDescription String?

  brandId    String?
  categoryId String?

  isNew        Boolean @default(false)
  isBestseller Boolean @default(false)
  isFeatured   Boolean @default(false)

  tags               String[] @default([])
  suitableFaceShapes String[] @default([])
  recommendedLens    String[] @default([])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  soldAt      DateTime?
  archivedAt  DateTime?
  deletedAt   DateTime?
  purgeAt     DateTime?

  brand    Brand?           @relation(fields: [brandId], references: [id])
  category Category?        @relation(fields: [categoryId], references: [id])
  images   ProductImage[]
  variants ProductVariant[]

  @@index([slug])
  @@index([status])
  @@index([brandId])
  @@index([categoryId])
  @@index([deletedAt])
  @@map("products")
}

model ProductVariant {
  id           String   @id @default(uuid())
  productId    String
  color        String
  colorHex     String?
  stock        Int      @default(0)
  availability String   @default("in-stock")
  videoUrl     String?
  createdAt    DateTime @default(now())

  product          Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  images           ProductImage[]
  compatibleLenses VariantLensCompatibility[]

  @@index([productId])
  @@map("product_variants")
}

// Only URLs are stored — actual files live in Cloudflare R2.
model ProductImage {
  id           String   @id @default(uuid())
  productId    String
  variantId    String?
  url          String
  webpUrl      String?
  avifUrl      String?
  thumbUrl     String?
  angle        String   @default("front")
  altText      String?
  isPrimary    Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@map("product_images")
}

// ------------------------------------------------------------------
// CONTENT
// ------------------------------------------------------------------

model Blog {
  id             String     @id @default(uuid())
  title          String
  slug           String     @unique
  excerpt        String?
  content        String
  featuredImage  String?
  category       String?
  tags           String[]   @default([])
  status         BlogStatus @default(DRAFT)
  scheduledFor   DateTime?
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  authorId       String?
  readTime       Int?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  @@index([slug])
  @@index([status])
  @@map("blogs")
}

model Offer {
  id            String      @id @default(uuid())
  title         String
  description   String?
  discountType  String      @default("percentage") // percentage | flat
  discountValue Decimal     @db.Decimal(10, 2)
  couponCode    String?     @unique
  bannerUrl     String?
  status        OfferStatus @default(ACTIVE)
  validFrom     DateTime    @default(now())
  validUntil    DateTime
  usageLimit    Int?
  usageCount    Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  @@index([status])
  @@index([couponCode])
  @@map("offers")
}

model Testimonial {
  id            String            @id @default(uuid())
  customerName  String
  customerImage String?
  rating        Int
  review        String
  source        String            @default("direct")
  status        TestimonialStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  @@index([status])
  @@map("testimonials")
}

// Store-specific policy/help content (returns, warranty, appointments, payment,
// etc). Public GET is consumed by the customer FAQ page; category groups items
// there exactly as this field's value groups them. sortOrder controls display
// order within a category (ascending); ties broken by createdAt.
model Faq {
  id          String    @id @default(uuid())
  question    String
  answer      String    @db.Text
  category    String    @default("General")
  sortOrder   Int       @default(0)
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([category])
  @@map("faqs")
}

model GalleryAlbum {
  id        String   @id @default(uuid())
  title     String
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items GalleryItem[]

  @@map("gallery_albums")
}

model GalleryItem {
  id           String    @id @default(uuid())
  albumId      String?
  url          String
  type         String    @default("image") // image | video
  altText      String?
  category     String
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  album GalleryAlbum? @relation(fields: [albumId], references: [id])

  @@index([category])
  @@map("gallery_items")
}

// ------------------------------------------------------------------
// BOOKINGS / ENQUIRIES / CONSULTATIONS
// ------------------------------------------------------------------

model EyeTestBooking {
  id              String        @id @default(uuid())
  customerName    String
  phone           String
  date            DateTime
  time            String
  concern         String?
  status          BookingStatus @default(PENDING)
  assignedStaffId String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  assignedStaff User? @relation("AssignedStaffBookings", fields: [assignedStaffId], references: [id])

  @@index([status])
  @@index([date])
  @@map("eye_test_bookings")
}

model ContactEnquiry {
  id              String        @id @default(uuid())
  name            String
  phone           String
  email           String?
  message         String
  status          EnquiryStatus @default(NEW)
  assignedStaffId String?
  notes           String?

  productId   String?
  productName String?
  lensType    String?

  // Legacy prescription fields for backwards compatibility with raw enquiries if needed
  prescriptionMode String?
  selectedPower    String?
  prescriptionUrl  String?
  rightEyeSphere   String?
  rightEyeCylinder String?
  rightEyeAxis     String?
  leftEyeSphere    String?
  leftEyeCylinder  String?
  leftEyeAxis      String?
  pdValue          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedStaff User? @relation("AssignedStaffEnquiries", fields: [assignedStaffId], references: [id])

  @@index([status])
  @@map("contact_enquiries")
}

model Prescription {
  id             String  @id @default(uuid())
  customerId     String?
  uploadedFileId String?
  // Plain R2 URL for the prescription photo. Customer uploads go through
  // POST /upload/public, which returns a URL — not a MediaAsset row — so
  // this is what actually gets populated today. uploadedFileId/uploadedFile
  // stay in place for when uploads are backed by real MediaAsset records.
  uploadedFileUrl String?

  sphereRight   Decimal? @db.Decimal(5, 2)
  sphereLeft    Decimal? @db.Decimal(5, 2)
  cylinderRight Decimal? @db.Decimal(5, 2)
  cylinderLeft  Decimal? @db.Decimal(5, 2)
  axisRight     Int?
  axisLeft      Int?
  pd            Decimal? @db.Decimal(5, 2)
  addPower      Decimal? @db.Decimal(5, 2)

  notes      String?
  status     String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  reviewedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  uploadedFile  MediaAsset?    @relation(fields: [uploadedFileId], references: [id])
  consultations Consultation[]

  @@map("prescriptions")
}

model Consultation {
  id                 String             @id @default(uuid())
  customerId         String?
  customerName       String?
  phone              String?
  email              String?
  prescriptionId     String?
  tenantId           String?
  catalogueVersionId String?
  status             ConsultationStatus @default(PENDING_REVIEW)
  assignedOpticianId String?

  commercialSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prescription     Prescription?     @relation(fields: [prescriptionId], references: [id])
  tenant           Tenant?           @relation(fields: [tenantId], references: [id])
  catalogueVersion CatalogueVersion? @relation(fields: [catalogueVersionId], references: [id])

  orders Order[]

  @@map("consultations")
}

model Order {
  id          String @id @default(uuid())
  orderNumber String @unique

  // Customer
  customerName String
  phone        String
  email        String?
  address      String
  fulfilment   String  @default("store-pickup") // store-pickup | home-delivery

  // Snapshot details for the core items (though fully captured in commercialSnapshot)
  productId    String?
  productName  String
  variantColor String?
  quantity     Int     @default(1)
  framePrice   Decimal @db.Decimal(10, 2)

  // Legacy fallback fields for lens details, now managed securely via commercialSnapshot and consultation
  lensType    String?
  lensPrice   Decimal @default(0) @db.Decimal(10, 2)
  totalAmount Decimal @db.Decimal(10, 2)
  amountPaid  Decimal @default(0) @db.Decimal(10, 2)
  amountDue   Decimal @default(0) @db.Decimal(10, 2)

  customerNotes    String? @db.Text
  expertAssistance Boolean @default(false)

  // Legacy prescription fields (retained for backward compatibility or direct orders without consultation)
  prescriptionMode String  @default("manual")
  selectedPower    String?
  prescriptionUrl  String?
  rightEyeSphere   String?
  rightEyeCylinder String?
  rightEyeAxis     String?
  leftEyeSphere    String?
  leftEyeCylinder  String?
  leftEyeAxis      String?
  pdValue          String?

  // External Relations (New SaaS Flow)
  consultationId     String?
  catalogueVersionId String?
  commercialSnapshot Json?

  // Payment
  paymentMethod   String        @default("upi") // upi | bank
  utrNumber       String?
  paymentProofUrl String?
  paymentStatus   PaymentStatus @default(PENDING)

  // Status
  status        OrderStatus     @default(NEW)
  notes         String?
  adminNotes    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  timeline      OrderTimeline[]
  returnRequest OrderReturn?

  consultation     Consultation?     @relation(fields: [consultationId], references: [id])
  catalogueVersion CatalogueVersion? @relation(fields: [catalogueVersionId], references: [id])

  @@index([status])
  @@index([paymentStatus])
  @@index([phone])
  @@map("orders")
}

// ------------------------------------------------------------------
// PLATFORM
// ------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String // LOGIN, LOGOUT, CREATE, UPDATE, DELETE, RESTORE, UPLOAD, DOWNLOAD, ARCHIVE, PUBLISH, FAILED_LOGIN
  resource   String // e.g. "product", "blog"
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([isRead])
  @@index([type])
  @@map("notifications")
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value Json

  @@map("settings")
}

model OrderTimeline {
  id          String   @id @default(uuid())
  orderId     String
  step        String
  label       String
  note        String?
  completedAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_timeline")
}

model OrderReturn {
  id        String       @id @default(uuid())
  orderId   String       @unique
  reason    String
  photoUrls String[]
  status    ReturnStatus @default(REQUESTED)
  adminNote String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("order_returns")
}
